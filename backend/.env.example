# ==============================================================================
# GESTOR MEI — VARIÁVEIS DE AMBIENTE DO BACKEND (PRODUÇÃO / BETA / LOCAL)
# ==============================================================================

# 0. Ambiente de Execução e Políticas de Inicialização (SPRINT SECURITY 1)
# Em produção configure: ENVIRONMENT=production
# O seed automático é permitido APENAS quando ENVIRONMENT=development ou SEED_DATABASE=true
ENVIRONMENT=development
SEED_DATABASE=false

# 1. Banco de Dados (PostgreSQL no Neon ou Supabase / SQLite para local)
# Exemplo Neon / Supabase: postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/gestor_mei?sslmode=require
# Exemplo Local: sqlite:///./gestor_mei.db
DATABASE_URL=postgresql://usuario:senha@ep-host.neon.tech/gestor_mei?sslmode=require

# 2. Segurança e Tokens JWT (Sprint Security 1 - Fase 2: 2h em prod, 12h em dev)
# Gere uma chave aleatória segura com 64 caracteres hexadecimais:
# powershell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
SECRET_KEY=gestor-mei-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 3. Regras Fiscais MEI
MEI_DEFAULT_ANNUAL_LIMIT=81000.00

# 4. CORS (Origens Permitidas separadas por vírgula em formato JSON ou string)
# Adicione a URL do seu frontend na Vercel: https://gestor-mei.vercel.app
CORS_ORIGINS=["https://gestor-mei.vercel.app","https://gestor-mei-beta.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# 5. Provisionamento do Usuário MASTER (SPRINT SECURITY 1 - FASE 1)
# O provisionamento do usuário MASTER depende exclusivamente destas variáveis:
# Em produção, configure um e-mail corporativo e uma senha forte (mínimo 8 caracteres):
MASTER_EMAIL=master@seudominio.com.br
MASTER_PASSWORD=SuaSenhaForte#2026
MASTER_NAME=Administrador MASTER

# 6. Cloudflare R2 Storage (S3-Compatible Object Storage)
# Armazenamento durável em nuvem para comprovantes de compra e arquivos XML NF-e.
# Se omitidas em ambiente local/desenvolvimento, o sistema opera automaticamente com LocalStorageProvider (backend/uploads/).
R2_ACCOUNT_ID=seu_cloudflare_account_id
R2_ACCESS_KEY_ID=sua_r2_access_key_id
R2_SECRET_ACCESS_KEY=sua_r2_secret_access_key
R2_BUCKET_NAME=gestor-mei-storage
# R2_ENDPOINT_URL é opcional; por padrão é montado via https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com


