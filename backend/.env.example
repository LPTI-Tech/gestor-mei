# ==============================================================================
# GESTOR MEI — VARIÁVEIS DE AMBIENTE DO BACKEND (PRODUÇÃO / BETA / LOCAL)
# ==============================================================================

# 1. Banco de Dados (PostgreSQL no Neon ou Supabase / SQLite para local)
# Exemplo Neon / Supabase: postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/gestor_mei?sslmode=require
# Exemplo Local: sqlite:///./gestor_mei.db
DATABASE_URL=postgresql://usuario:senha@ep-host.neon.tech/gestor_mei?sslmode=require

# 2. Segurança e Tokens JWT
# Gere uma chave aleatória segura com 64 caracteres hexadecimais:
# powershell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
SECRET_KEY=gestor-mei-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Regras Fiscais MEI
MEI_DEFAULT_ANNUAL_LIMIT=81000.00

# 4. CORS (Origens Permitidas separadas por vírgula em formato JSON ou string)
# Adicione a URL do seu frontend na Vercel: https://gestor-mei.vercel.app
CORS_ORIGINS=["https://gestor-mei.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

